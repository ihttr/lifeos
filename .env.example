# ============================================================
# LifeOS — نسخة هذا الملف إلى .env واملأ القيم
# لا تضع أي قيمة حقيقية في هذا الملف (فهو مرفوع على git)
# ============================================================

# --- قاعدة البيانات ---
# التطوير المحلي: شغّل `npx prisma dev` وانسخ الرابط الذي يطبعه
# الإنتاج: رابط الاتصال المجمّع (pooled) من Neon
DATABASE_URL="postgresql://user:password@host:5432/lifeos?sslmode=require"

# --- المصادقة ---
# ولّد المفتاح بالأمر: npx auth secret
# أو: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# رابط التطبيق — غيّره لرابط الإنتاج عند النشر
AUTH_URL="http://localhost:3000"

# --- حساب المستخدم الأول (يُستخدم في db:seed فقط) ---
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD=""
SEED_USER_NAME="اسمك"

# --- بوت تيليجرام (اختياري — اتركها فارغة والبوت معطّل) ---
# التوكن من @BotFather
TELEGRAM_BOT_TOKEN="7567690696:AAFFNB7ro4n78Pu0x1P1XJsdcmx4-Sw8lFc"

# سرّ تختاره أنت، يتحقق منه الـ webhook في كل طلب.
# ولّده بالأمر: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET="8accb234ea5e268b9108b76f8968c63e4dbe03e03373f783"

# معرّف محادثتك — البوت يقبل الرسائل من هذه المحادثة وحدها.
# للحصول عليه: راسل البوت، ثم شغّل `npm run telegram:whoami`
TELEGRAM_CHAT_ID="1420746702"

# سرّ الملخص الصباحي المجدول. Vercel Cron يرسله تلقائياً في ترويسة
# Authorization، ويمكن نداء المسار يدوياً بـ ?key=<القيمة>
CRON_SECRET="4c13c62a6c3b9edb6fa4aff0fb99ff398a22ef0fd6eab0a8"

