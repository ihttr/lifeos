# ============================================================
# LifeOS — نسخة هذا الملف إلى .env واملأ القيم
# لا تضع أي قيمة حقيقية في هذا الملف (فهو مرفوع على git)
# ============================================================

# --- قاعدة البيانات ---
# التطوير المحلي: شغّل `npx prisma dev` وانسخ الرابط الذي يطبعه
# الإنتاج: رابط الاتصال المجمّع (pooled) من Neon
DATABASE_URL="postgresql://user:password@host:5432/lifeos?sslmode=require"

# --- المصادقة ---
# ولّد المفتاح بالأمر: npx auth secret
# أو: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# رابط التطبيق — غيّره لرابط الإنتاج عند النشر
AUTH_URL="http://localhost:3000"

# --- حساب المستخدم الأول (يُستخدم في db:seed فقط) ---
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD=""
SEED_USER_NAME="اسمك"
